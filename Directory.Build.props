<Project>
  <ItemGroup>
    <PackageReference Include="LitJson" Version="0.19.0" GeneratePathProperty="true" ExcludeAssets="all" />
    <!-- Use the same Mono-compatible assembly in the mod and integration tests. -->
    <Reference Include="LitJSON">
      <HintPath>$(PkgLitJson)/lib/net20/LitJSON.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
