<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>12</LangVersion>
    <AssemblyName>Patice</AssemblyName>
    <RootNamespace>Patice</RootNamespace>
    <Version>0.2.36</Version>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <ReferencePath>$(MSBuildProjectDirectory)/.build/references</ReferencePath>
    <OutputPath>$(MSBuildProjectDirectory)/dist/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="segments/**/*.json" Exclude="segments/**/*.schema.json"
                      LogicalName="Patice.Segments.%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="src/**/*.cs" />
    <PackageReference Include="ILRepack.Lib.MSBuild.Task" Version="2.0.48" GeneratePathProperty="true" ExcludeAssets="all" PrivateAssets="all" />
    <Reference Include="$(ReferencePath)/*.dll" Exclude="$(ReferencePath)/mscorlib.dll;$(ReferencePath)/System*.dll;$(ReferencePath)/Mono*.dll">
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <UsingTask TaskName="ILRepack" AssemblyFile="$(PkgILRepack_Lib_MSBuild_Task)/build/ILRepack.Lib.MSBuild.Task.dll" />
  <Target Name="BundleDependencies" AfterTargets="Build">
    <ILRepack InputAssemblies="$(TargetPath);@(ReferenceCopyLocalPaths)"
              OutputFile="$(TargetPath)" LibraryPath="$(ReferencePath)"
              Internalize="true" TargetKind="Dll" DebugInfo="false" />
  </Target>
</Project>
