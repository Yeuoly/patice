{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Practice segments",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "musicId",
      "difficulty",
      "id",
      "name",
      "startMs",
      "endMs"
    ],
    "properties": {
      "musicId": {
        "type": "integer",
        "minimum": 1
      },
      "difficulty": {
        "enum": [
          "basic",
          "advanced",
          "expert",
          "master",
          "remaster",
          "utage"
        ]
      },
      "id": {
        "type": "string",
        "format": "uuid"
      },
      "name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 40
      },
      "startMs": {
        "type": "integer",
        "minimum": 0
      },
      "endMs": {
        "type": "integer",
        "minimum": 1
      }
    }
  }
}
