{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SDEZ named practice segments v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "chart",
    "timeBase",
    "segments"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "exampleOnly": {
      "type": "boolean",
      "default": false
    },
    "chart": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "musicId",
        "difficulty"
      ],
      "properties": {
        "musicId": {
          "type": "integer",
          "minimum": 1
        },
        "difficulty": {
          "enum": [
            "basic",
            "advanced",
            "expert",
            "master",
            "remaster",
            "utage"
          ]
        }
      }
    },
    "timeBase": {
      "const": "music-start-ms"
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "startMs",
          "endMs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "startMs": {
            "type": "integer",
            "minimum": 0
          },
          "endMs": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "maxItems": 256
    }
  },
  "$comment": "Runtime validation also requires unique segment ids; startMs < endMs <= actual song end; Chart musicId and difficulty match the current selection. Interval is [startMs,endMs). exampleOnly=true files are rejected by production loader. No timing data is shared implicitly across difficulties."
}
